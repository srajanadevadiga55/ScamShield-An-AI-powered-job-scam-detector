# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing session tokens (any random 32+ char string).
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"

# Gmail / SMTP Email OTP Delivery (Required only if you want OTPs emailed to real inboxes)
# Leave SMTP_USER / SMTP_PASS blank in local dev to view the OTP on screen instead.
SMTP_USER=""
SMTP_PASS=""
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_FROM=""

# Optional Threat Intelligence & External Database Overrides:
# GOOGLE_SAFE_BROWSING_API_KEY=""
# VIRUSTOTAL_API_KEY=""
# MONGODB_URI=""
# MONGODB_DB_NAME="scamshield"

